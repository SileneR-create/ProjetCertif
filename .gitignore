# ── Secrets & config locaux ───────────────────────────────────────────────────
.env

# ── Environnement Python ──────────────────────────────────────────────────────
.venv/
**/__pycache__/
*.py[cod]
*.pyo

# ── Caches outils ─────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Jupyter ───────────────────────────────────────────────────────────────────
**/.ipynb_checkpoints/
Notebook/cache/
Notebook/.cache.sqlite
Notebook/*.pkl

# ── MLflow (artefacts locaux — le serveur MLflow tourne dans Docker) ──────────
mlflow.db
mlruns/
mlartifacts/

# ── Bases SQLite de développement (l'app utilise PostgreSQL en prod) ──────────
travelmatch.db
frontend/travelmatch.db
backend/database/*.db
DATA/external/*.db

# ── Données brutes (archives volumineuses, pas de valeur dans l'historique) ───
DATA/raw/*.zip
DATA/raw/cities500.*

# ── Documents de certification ────────────────────────────────────────────────
E*.docx

# ── Screenshots et images de documentation ────────────────────────────────────
images/

# ── Fichiers de debug/migration one-shot ─────────────────────────────────────
diag.py
debug.py
front
database_origin.py
migrate_db.py
admin_setup_db.py
