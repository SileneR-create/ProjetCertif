{
  "title": "TravelMatch — Monitoring & Dérive Modèle",
  "uid": "travelmatch-main",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["travelmatch", "mlops", "certification"],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "🟢 Santé de l'API",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Service UP",
      "description": "1 = API disponible, 0 = hors service",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "up{job=\"fastapi-backend\"}",
          "legendFormat": "API",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Requêtes/min",
      "description": "Taux d'appels entrants sur l'ensemble des endpoints",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 } ] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"fastapi-backend\"}[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Taux d'erreurs 5xx",
      "description": "Proportion de réponses HTTP 5xx — seuil d'alerte : > 1 %",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"fastapi-backend\",status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"fastapi-backend\"}[5m]))",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Recommandations totales",
      "description": "Compteur cumulé d'appels à POST /recommendations",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "travelmatch_recommandations_total",
          "legendFormat": "total",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Latence p50 / p95 / p99 — POST /recommendations",
      "description": "Signal clé pour détecter une régression de performance (incident #001 : p95 à 3 400 ms)",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 500 } ] }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{handler=\"/recommendations\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=\"/recommendations\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{handler=\"/recommendations\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },

    {
      "id": 7,
      "type": "row",
      "title": "🤖 Monitoring Modèle IA — Dérive (C11 / C20)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false
    },

    {
      "id": 8,
      "type": "gauge",
      "title": "Score moyen de matching",
      "description": "Jauge 0–100. Si descend durablement sous 60 → signal de dérive du modèle (C20)",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 14 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 75 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [
        {
          "expr": "travelmatch_score_moyen_matching",
          "legendFormat": "Score moyen",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "type": "gauge",
      "title": "Score minimum de matching",
      "description": "Score le plus bas parmi les top-N retournés. Un effondrement indique un problème de données ou de modèle.",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 14 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 40 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [
        {
          "expr": "travelmatch_score_min_matching",
          "legendFormat": "Score min",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Score moyen de matching — évolution",
      "description": "Tendance sur la fenêtre de temps. Une baisse progressive = dérive du modèle → réentraînement à déclencher (C20).",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 60 } ] }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "hidden" }
      },
      "targets": [
        {
          "expr": "travelmatch_score_moyen_matching",
          "legendFormat": "Score moyen",
          "refId": "A"
        }
      ]
    },

    {
      "id": 11,
      "type": "piechart",
      "title": "Distribution des clusters recommandés",
      "description": "Si un seul cluster domine > 80 % → le modèle a peut-être convergé vers un seul archétype (dérive C20).",
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 21 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "increase(travelmatch_cluster_recommande_total[1h])",
          "legendFormat": "{{cluster_label}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Distribution des clusters — évolution temporelle",
      "description": "Permet de voir si la distribution des archetypes de recommandation se stabilise ou dérive dans le temps.",
      "gridPos": { "h": 8, "w": 14, "x": 10, "y": 21 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "none" } }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(travelmatch_cluster_recommande_total[5m])",
          "legendFormat": "{{cluster_label}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 13,
      "type": "row",
      "title": "⚡ Latence globale — tous endpoints",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "Latence p95 — tous endpoints",
      "description": "Vue d'ensemble de la latence de l'API. Un pic soutenu > 500 ms déclenche l'alerte.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 30 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"fastapi-backend\"}[5m])) by (le, handler)) * 1000",
          "legendFormat": "{{handler}} p95",
          "refId": "A"
        }
      ]
    }

  ],

  "templating": { "list": [] },
  "links": []
}
