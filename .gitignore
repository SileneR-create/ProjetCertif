# ── Secrets & config locaux ───────────────────────────────────────────────────
.env

# ── Environnement Python ──────────────────────────────────────────────────────
.venv/
**/__pycache__/
*.py[cod]
*.pyo

# ── Caches outils ─────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Jupyter ───────────────────────────────────────────────────────────────────
**/.ipynb_checkpoints/
Notebook/cache/
Notebook/.cache.*

# ── MLflow (artefacts locaux — le serveur MLflow tourne dans Docker) ──────────
mlflow.db
mlruns/
mlartifacts/

# ── Bases de données locales (l'app utilise PostgreSQL en prod) ───────────────
*.db
*.sqlite
*.sqlite3

# ── Modèles ML sérialisés ────────────────────────────────────────────────────
*.pkl
*.joblib
*.h5
*.pt
*.pth

# ── Données brutes et intermédiaires ─────────────────────────────────────────
DATA/raw/
DATA/external/
DATA/processed/*.csv
!DATA/processed/data_clean.csv

# ── Présentations et documents bureautiques ───────────────────────────────────
*.pptx
*.ppt
*.pptm
*.xlsx
*.xls
*.xlsm
*.docx
*.pdf

# ── Photos, vidéos et médias ──────────────────────────────────────────────────
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.webp
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav

# ── Screenshots hors documentation ───────────────────────────────────────────
qa_slide-*.png

# ── Fichiers de debug/migration one-shot ─────────────────────────────────────
diag.py
debug.py
front
database_origin.py
migrate_db.py
admin_setup_db.py
